-- Copies the live FixChap data from MySQL into PostgreSQL with pgloader (https://pgloader.io).
--   brew install pgloader        (or: apt install pgloader)
--   createdb fixchap
--   pgloader database/mysql-to-postgres.load
-- Edit the two connection strings first. Run it during a quiet period and stop the Laravel app
-- (or put it in maintenance mode) so no new requests are written to MySQL while copying.

LOAD DATABASE
  FROM mysql://MYSQL_USER:MYSQL_PASSWORD@MYSQL_HOST:3306/fixchap
  INTO postgresql://PG_USER:PG_PASSWORD@PG_HOST:5432/fixchap

WITH include drop, create tables, create indexes, reset sequences, downcase identifiers,
     workers = 4, concurrency = 1

-- Keep the column types the app expects: plain timestamps (no timezone shift), 0/1 smallints for
-- tinyint flags, NULL for MySQL zero dates, and text instead of varchar(n) so long addresses fit.
CAST type datetime to timestamp drop not null using zero-dates-to-null,
     type timestamp to timestamp drop not null using zero-dates-to-null,
     type date drop not null using zero-dates-to-null,
     type tinyint to smallint drop typemod,
     type enum to varchar drop typemod,
     type varchar to text drop typemod,
     type double to float8 drop typemod,
     type bigint with extra auto_increment to bigserial drop typemod,
     type bigint when unsigned to bigint drop typemod,
     type int with extra auto_increment to serial drop typemod,
     type int to integer drop typemod

-- Laravel bookkeeping tables the new app does not use
EXCLUDING TABLE NAMES MATCHING 'migrations', 'password_reset_tokens', 'sessions', 'cache', 'cache_locks',
                               'jobs', 'job_batches', 'failed_jobs', 'personal_access_tokens'

-- pgloader puts tables in a schema named after the MySQL database; move them to public
ALTER SCHEMA 'fixchap' RENAME TO 'public';
