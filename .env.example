# ============================================================
# FixChap production settings. Copy to .env and fill in.
#   cp .env.example .env && nano .env
# Never commit or share the .env file.
# ============================================================

# --- Public address (used for share previews, sitemap and photo links) ---
APP_URL=https://fixchap.co.tz
# Domain names served by nginx (space separated) — include admin.fixchap.co.tz so the mobile apps keep working
SERVER_NAMES="fixchap.co.tz www.fixchap.co.tz admin.fixchap.co.tz"
# The certificate is stored under this name (normally the first of SERVER_NAMES)
PRIMARY_DOMAIN=fixchap.co.tz
# Let's Encrypt account / expiry warnings
LETSENCRYPT_EMAIL=info@fixchap.com
# Ports nginx listens on (change only if something else already uses 80/443)
HTTP_PORT=80
HTTPS_PORT=443
# App port on the server itself (health checks); not public
APP_PORT=3000
# Same as Laravel's APP_TIMEZONE (created_at/updated_at are written in this timezone)
APP_TIMEZONE=UTC

# --- Database (PostgreSQL container) ---
POSTGRES_DB=fixchap
POSTGRES_USER=fixchap
# Long random password, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# --- Dashboard login signing key (openssl rand -hex 32) ---
AUTH_SECRET=change-me

# --- Uploaded photos ---
# Leave empty to use ./data/... inside this folder, or point at the Laravel folders to keep old photos:
#   STORAGE_HOST_DIR=/var/www/FixChap/storage/app/public
#   HANDYMAN_IMG_HOST_DIR=/var/www/FixChap/public/handyman_img
STORAGE_HOST_DIR=
HANDYMAN_IMG_HOST_DIR=
# Photo URL prefix sent to the apps (usually APP_URL + /handyman_img/)
HANDYMAN_IMG_URL=https://fixchap.co.tz/handyman_img/

# --- Firebase push notifications ---
# Put the service-account file at ./secrets/credentials-file.json
FCM_PROJECT_ID=fixchap

# --- SMS (sms.co.tz) for login codes ---
SMS_USERNAME=
SMS_PASSWORD=
SMS_SENDER_ID=FixChap
# Numbers that always get code 1020 (app-store reviewers only)
OTP_TEST_NUMBERS=
OTP_TEST_NUMBERS_FUNDI=

# --- Email alerts to the office (SMTP) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@fixchap.co.tz
MAIL_FROM_NAME=FixChap
OFFICE_EMAILS=fixchaptz@gmail.com,fixchapoffice@gmail.com

# --- Optional ---
# (APP_URL and the Google Maps key are also baked into the build — set them in fixchap-next/.env.production)
# true = anyone can open the API docs at /docs
DOCS_PUBLIC=false
# Days of no use before an app session expires
SESSION_MAX_IDLE_DAYS=90

# --- Only used while migrating from MySQL (scripts/migrate-from-dump.sh) ---
MIGRATE_MYSQL_PASSWORD=fixchap-temp-only
